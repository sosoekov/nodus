# Скопируйте в .env и поправьте под себя.

POSTGRES_USER=nodus
POSTGRES_PASSWORD=nodus
POSTGRES_DB=nodus
POSTGRES_PORT=5432

API_PORT=3000

# Обязательно смените: этим ключом подписывается сессионная cookie.
SESSION_SECRET=change-me-to-a-long-random-string

# true — если сервис за HTTPS.
COOKIE_SECURE=false

# Пароль сидовых учёток admin@nodus.local / editor@nodus.local / viewer@nodus.local
SEED_PASSWORD=nodus

LOG_LEVEL=info
